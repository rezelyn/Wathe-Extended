{
  "schemaVersion": 1,
  "id": "watheextended",
  "version": "${version}",
  "name": "Wathe Extended",
  "description": "Add-on mod for Wathe: Murder Mystery, made for \"The Harpy Express: Extended\" modpack.",
  "authors": [
    "Rezelyn (Owner)",
    "yoy333 (Maintainer)"
  ],
  "contributors": [
    "ItsSyfe",
    "Basinity",
    "math730 (French localization)",
    "haiman233 (Chinese localization)",
    "Celemimphar (Ish Plush model & texture)",
    "\nSpecial thanks:\n- The D.R. Harpy Transportation Ltd. Discord server for being psychopaths",
    "\nAdditional assets:\n- LadySnake (Wathe: Murder Mystery)"
  ],
  "contact": {
    "sources": "https://github.com/rezelyn/Wathe-Extended",
    "issues": "https://github.com/rezelyn/Wathe-Extended/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/watheextended/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "cat.rezelyn.watheextended.client.WatheExtendedDataGenerator"
    ],
    "client": [
      "cat.rezelyn.watheextended.client.WatheExtendedClient"
    ],
    "main": [
      "cat.rezelyn.watheextended.WatheExtended"
    ],
    "cardinal-components": [
      "cat.rezelyn.watheextended.component.WatheExtendedComponents"
    ]
  },
  "mixins": [
    "watheextended.mixins.json",
    {
      "config": "watheextended.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "yet_another_config_lib_v3": ">=3.8.2+1.21.1-fabric",
    "wathe": ">=1.4-1.21.1",
    "harpymodloader": ">=1.2.5-h1.4"
  },
  "custom": {
    "cardinal-components": [
      "watheextended:mapvariables"
    ]
  }
}
